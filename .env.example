# Choose one authentication method for the Vercel API function.
# Service account JSON must be stored as one-line JSON in Vercel.
GDRIVE_SERVICE_ACCOUNT_JSON=
# Or use a Google OAuth refresh token:
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
